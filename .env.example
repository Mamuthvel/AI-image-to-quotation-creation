# Vision provider for reading handwritten sheets: anthropic | gemini
# Leave both keys blank to run the demo on the bundled sample sheet.
VISION_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Voice input (reading a list aloud) always goes through Gemini, regardless of
# VISION_PROVIDER above - Claude's API does not accept audio. Leave GEMINI_API_KEY
# blank to have the mic button fall back to the bundled sample sheet too.

PORT=3000
